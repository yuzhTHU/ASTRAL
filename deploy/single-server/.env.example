ASTRAL_WEB_IMAGE=astral-local-web:latest
ASTRAL_HARNESS_IMAGE=astral-local-harness:latest
POSTGRES_IMAGE=postgres:17-alpine
DB_PASSWORD=replace-with-random-hex-password
HARNESS_SERVICE_TOKEN=replace-with-at-least-24-random-characters
CREDENTIAL_MASTER_KEY=replace-with-base64-encoded-32-random-bytes
APP_ORIGIN=https://astral.thuai4s.ai
COOKIE_SECURE=true
POSTGRES_DATA_DIR=/data/pgsql
HARNESS_DATA_DIR=/data/astral/harness-data
SAMPLE_DATA_DIR=/data/astral/samples
